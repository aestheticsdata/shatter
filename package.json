{
  "name": "shatter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:backgrounds": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-backgrounds.mjs",
    "check:bestiary": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-bestiary.mjs",
    "check:drops": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-drops.mjs",
    "check:pix": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-pix.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "video:generate": "playwright test --config playwright.demo.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.4.0",
    "lightningcss": "^1.32.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  },
  "packageManager": "pnpm@12.2.1"
}
